  "author": "WilliamAxelC <williamaxelcuangdinata@gmail.com>",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
